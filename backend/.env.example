# OpenAI — used ONLY by the separate, unrelated cosmetic display-map
# recoloring/regeneration feature (services/map_image_service.py,
# generate_openai_display_map / the "Use OpenAI processing" checkbox in
# Map Management). This is NOT used by semantic map analysis — see the
# Anthropic block below for that.
OPENAI_API_KEY=

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_MAX_EDGE=2048

# Anthropic — used by automatic semantic map analysis (see backend/
# services/semantic_analysis_service.py and backend/prompts/
# quickroute_semantic_map_import_v2.txt), via Anthropic's native Python
# SDK and Messages API. Separate from OPENAI_API_KEY above; the two
# features never share a provider, key, or model setting.
ANTHROPIC_API_KEY=

# Independently configurable model for semantic map analysis only — never
# reused by any other feature.
ANTHROPIC_MAP_ANALYSIS_MODEL=claude-sonnet-4-20250514

# When true, every map upload that finishes processing successfully
# automatically enqueues a semantic-analysis job (never blocks the upload
# response; the Claude call itself happens later, out-of-band, in the
# background worker). Set to false to require an admin to press
# "Start Analysis" manually instead.
AUTO_ANALYZE_MAPS=true

# How many additional attempts a transient failure (rate limit, timeout,
# network error, truncated output, malformed JSON) gets before the worker
# leaves the job permanently "failed" instead of requeuing it.
SEMANTIC_ANALYSIS_MAX_RETRIES=2

# A "processing" analysis job that has been claimed by a worker for
# longer than this is treated as stale/crashed and safely requeued.
SEMANTIC_ANALYSIS_JOB_TIMEOUT_SECONDS=900

# Upper bound (max_tokens) passed to the Anthropic Messages API call for
# this analysis (the semantic JSON contract can be large for a map with
# many rooms).
SEMANTIC_ANALYSIS_MAX_OUTPUT_TOKENS=60000

# Reserved for a future strict JSON-Schema-constrained mode. The current
# implementation always relies on the fixed prompt + a strict system
# instruction + local Pydantic validation (see Section 4 of the migration
# spec) regardless of this value; it is read but not yet enforced.
SEMANTIC_ANALYSIS_STRICT_SCHEMA=true

# Images sent to Claude for semantic analysis are downscaled (never
# upscaled) so their longest edge is at most this many pixels, to stay
# comfortably under Anthropic's request-size limits and reduce token
# usage. PDFs are exempt — every page is always sent at full resolution
# so no page is ever silently dropped.
MAP_IMAGE_MAX_EDGE=2048

# Map upload and processing
MAP_MAX_UPLOAD_SIZE_MB=50
MAP_PDF_RENDER_DPI=200
AI_EDGE_SCORE_THRESHOLD=0.42

# MongoDB Atlas connection (ask a teammate for the real credentials)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=QuickRouteCluster
DATABASE_NAME=quickroute_db

# Optional shared map-image storage (Phase 9). Leave blank to keep using
# local disk storage under backend/uploads/.
MAP_STORAGE_BACKEND=local
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT auth (Phase 8)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Invitation Codes — dev-only bootstrap endpoint
# Leave unset/false in every real environment. When "true", enables
# POST /api/invitation-codes/dev-create, which can mint the very first
# super_admin invitation code on a brand-new database (no admin exists
# yet to authenticate as). It refuses to run at all once any super_admin
# account already exists, so it can never be used to escalate privilege
# once a real admin hierarchy is set up. Normal invitation-code creation
# always goes through the authenticated Admin UI
# (POST /api/invitation-codes), never through this endpoint.
ALLOW_DEV_INVITATION_ENDPOINTS=false
