# OpenAI
OPENAI_API_KEY=

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_MAX_EDGE=2048

# Map upload and processing
MAP_MAX_UPLOAD_SIZE_MB=50
MAP_PDF_RENDER_DPI=200
AI_EDGE_SCORE_THRESHOLD=0.42

# MongoDB Atlas connection (ask a teammate for the real credentials)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=QuickRouteCluster
DATABASE_NAME=quickroute_db

# Optional shared map-image storage (Phase 9). Leave blank to keep using
# local disk storage under backend/uploads/.
MAP_STORAGE_BACKEND=local
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# JWT auth (Phase 8)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
